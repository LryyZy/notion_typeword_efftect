<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notion 打字机效果</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: transparent !important;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .typewriter-container {
            width: 100%;
            max-width: 600px;
            background: transparent;
        }
        
        .typewriter-text {
            color: #37352f; /* Notion 文字颜色 */
            font-size: 16px;
            line-height: 1.5;
            overflow: hidden;
            border-right: 3px solid #37352f; /* 光标 */
            white-space: normal; /* 允许多行 */
            word-wrap: break-word;
            width: 0;
            animation: 
                typing 4s steps(60, end) forwards,
                blink-caret 0.75s step-end infinite 4s;
        }
        
        @keyframes typing {
            from { width: 0 }
            to { width: 100% }
        }
        
        @keyframes blink-caret {
            from, to { border-color: transparent }
            50% { border-color: #37352f }
        }
        
        /* 响应式调整 */
        @media (max-width: 640px) {
            .typewriter-text {
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <div class="typewriter-container">
        <div class="typewriter-text" id="text">
            歡迎，訪客01。
        </div>
    </div>

    <script>
        // 从 URL 参数获取文字内容（可选）
        function getTextFromURL() {
            const params = new URLSearchParams(window.location.search);
            const text = params.get('text');
            if (text) {
                return decodeURIComponent(text);
            }
            return null;
        }
        
        // 从本地存储获取文字（可选）
        function getTextFromStorage() {
            return localStorage.getItem('notion-typewriter-text');
        }
        
        // 设置文字内容
        function setText(content) {
            const textElement = document.getElementById('text');
            if (content) {
                textElement.textContent = content;
            }
        }
        
        // 初始化
        document.addEventListener('DOMContentLoaded', function() {
            let text = getTextFromURL() || getTextFromStorage() || document.getElementById('text').textContent;
            setText(text);
            
            // 动画结束后移除光标
            const textElement = document.getElementById('text');
            setTimeout(() => {
                textElement.style.borderRight = 'none';
            }, 4000); // 与动画时间一致
        });
    </script>
</body>
</html>
